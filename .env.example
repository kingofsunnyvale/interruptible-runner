# Copy to .env (gitignored). Never commit the real values.

# HMAC secret returned by POST /api/v0/webhooks/ — written by `make webhook`.
WEBHOOK_SECRET=

# Absolute cap on our bid, $/hr. The effective ceiling is
# min(MAX_HOURLY, CEILING_FRACTION * on-demand price of the same machine).
MAX_HOURLY=0.60
CEILING_FRACTION=0.90

# Rebid policy knobs (see controller/state.py).
BID_STEP=0.02
MIN_BID_MULT=1.05
REBID_DEBOUNCE_SECS=15
MAX_REBID_ATTEMPTS=5
START_FALLBACK_SECS=45
STARVED_AFTER_SECS=90

# Poll cadence (docs recommend ~10 s).
POLL_SECS=10

# Worker knobs, passed through at launch.
N_IMAGES=100
STEPS=25
